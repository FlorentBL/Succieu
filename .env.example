# Espace bureau — copier en .env.local (dev) ou dans l'environnement du service (prod).
# Ne jamais versionner de valeurs réelles.

# Dossier des données (articles.json, events.json, bureau.json, uploads/).
# Dev : ./data (défaut). Prod : /var/lib/succieu-web
DATA_DIR=./data

# Empreintes scrypt : node scripts/hash-password.mjs
# Les "$" doivent être échappés dans un fichier .env lu par Next ("\$") ou la valeur mise entre apostrophes dans un EnvironmentFile systemd.
BUREAU_PASSWORD_HASH=
ADMIN_PASSWORD_HASH=

# Secret de signature des sessions, 32 caractères minimum : openssl rand -base64 48
SESSION_SECRET=

# Jeton Bearer de l'agent de relecture, 24 caractères minimum : openssl rand -base64 36
REVIEW_API_TOKEN=

# Facultatif : origines supplémentaires autorisées pour les requêtes d'écriture (séparées par des virgules)
# SITE_ORIGINS=https://www.succieu.fr
