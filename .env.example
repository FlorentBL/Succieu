# Espace bureau — copier en .env.local (dev) ou dans l'environnement du service (prod).
# Ne jamais versionner de valeurs réelles.

# Dossier des données (articles.json, events.json, users.json, uploads/).
# Dev : ./data (défaut). Prod : /var/lib/succieu-web
DATA_DIR=./data

# (BUREAU_PASSWORD_HASH et ADMIN_PASSWORD_HASH ont été supprimées : connexion par comptes individuels du hub.)

# Secret de signature des sessions, 32 caractères minimum : openssl rand -base64 48
SESSION_SECRET=

# Jeton Bearer de l'agent de relecture, 24 caractères minimum : openssl rand -base64 36
REVIEW_API_TOKEN=

# Facultatif : origines supplémentaires autorisées pour les requêtes d'écriture (séparées par des virgules)
# SITE_ORIGINS=https://www.succieu.fr

# Hub /espace-bureau (comptes individuels) : durée de la session en heures (défaut 2160 = 90 jours).
# Les comptes sont dans DATA_DIR/users.json ; le premier admin se crée sur le serveur :
#   DATA_DIR=/var/lib/succieu-web node scripts/hub-create-admin.mjs <prenom> ["Nom affiché"]
# HUB_SESSION_HOURS=2160

# Hub /espace-bureau, module Documents : adresse du drive (https uniquement, lue côté serveur).
# Absente ou invalide : https://drive.succieu.fr/
# BUREAU_DRIVE_URL=https://drive.succieu.fr/
